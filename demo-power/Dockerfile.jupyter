# ─────────────────────────────────────────────────────────────────────────────
# JupyterLab + PyPy environment for teem-exercise
#
# Browser-accessible JupyterLab on CPython 3.12 with PyPy 3 available as a
# shell tool for the heavy trace-generation workloads in headless_main.py.
#
# Build (from repo root):
#   docker build -f demo-power/Dockerfile.jupyter -t teem-jupyter .
#
# Run:
#   docker run --rm -it -p 127.0.0.1:8888:8888 -v "$(pwd)":/work \
#              --user "$(id -u):$(id -g)" teem-jupyter
#   Then visit http://localhost:8888
#   (127.0.0.1: prefix on -p binds the port to loopback only — required
#   because --ServerApp.token= disables Jupyter's auth.)
# ─────────────────────────────────────────────────────────────────────────────
FROM python:3.12-slim

LABEL org.opencontainers.image.source="https://github.com/JHeinzde/teem-exercise"
LABEL org.opencontainers.image.description="JupyterLab + PyPy environment for teem-exercise"
LABEL org.opencontainers.image.licenses="GPL-2.0-only"

ARG DEBIAN_FRONTEND=noninteractive

# System packages: PyPy 3 (Debian bookworm ships PyPy 7.3 / Python 3.9), plus
# git/curl for in-container workflows. No build-essential: every Python dep
# used here ships manylinux wheels for cp312 and pp39.
RUN apt-get update \
 && apt-get install -y --no-install-recommends \
        pypy3 \
        git \
        curl \
        ca-certificates \
 && rm -rf /var/lib/apt/lists/*

# CPython side: JupyterLab + project runtime deps.
# requirements.txt is COPYed from the repo root (build context = repo root).
COPY requirements.txt /tmp/requirements.txt
RUN pip install --no-cache-dir "jupyterlab>=4,<5" -r /tmp/requirements.txt

# PyPy side: only the deps headless_main.py needs. No matplotlib/ipympl —
# PyPy is for trace generation, not plotting.
# Debian's pypy3 ships without `ensurepip` AND marks the install as
# PEP 668 externally-managed. Since this container is a single-purpose
# environment we own end-to-end, bootstrap pip via get-pip.py and pass
# --break-system-packages to opt out of PEP 668 enforcement.
RUN curl -fsSL https://bootstrap.pypa.io/get-pip.py | pypy3 - --break-system-packages \
 && pypy3 -m pip install --no-cache-dir --break-system-packages \
        "python-benedict[yaml]" \
        prompt_toolkit \
        numpy

# Jupyter writes its config / runtime / data dirs under $HOME. When the
# container runs with `--user $(id -u):$(id -g)`, that UID has no entry in
# /etc/passwd and $HOME defaults to "/", which is root-owned. Point HOME at
# /tmp (already world-writable, mode 1777) so JupyterLab can start under
# any UID. Runtime files are session-scoped, so /tmp is fine.
ENV HOME=/tmp

WORKDIR /work
EXPOSE 8888

# --allow-root is defensive: if the user forgets --user $(id -u):$(id -g) at
# run time, JupyterLab still starts instead of refusing. With --user set,
# the flag is a no-op.
CMD ["jupyter", "lab", \
     "--ip=0.0.0.0", \
     "--no-browser", \
     "--allow-root", \
     "--ServerApp.token=", \
     "--ServerApp.password="]
